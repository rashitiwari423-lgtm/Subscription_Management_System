# ===========================================
# SubscriptIQ - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=subscriptiq
DB_USERNAME=root
DB_PASSWORD=password
DB_POOL_MAX=20
DB_POOL_MIN=5

# Server Configuration
SERVER_PORT=8080

# Security & JWT Configuration
JWT_SECRET=your_at_least_256_bit_secret_base64_encoded_or_raw_string_here
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=120

# Bootstrap Initial Admin (Only used on first startup if no ADMIN exists)
INITIAL_ADMIN_NAME=Platform Administrator
INITIAL_ADMIN_EMAIL=admin@subscriptiq.com
INITIAL_ADMIN_PASSWORD=YourAdminPassword@123

# Mail Configuration (Optional in development)
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@subscriptiq.com

# Recurring Billing Scheduler Configuration
BILLING_SCHEDULER_ENABLED=true
BILLING_SCHEDULER_CRON=0 0 1 * * *
INVOICE_DUE_DAYS=7
