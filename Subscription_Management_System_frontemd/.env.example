# ===========================================
# SubscriptIQ - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=subscriptiq
DB_USERNAME=root
DB_PASSWORD=password

# Server Configuration
SERVER_PORT=8080

# JWT Configuration
JWT_SECRET=replace-with-a-long-random-secret-key-at-least-256-bits
JWT_EXPIRATION_MS=86400000

# Bootstrap Initial Admin (Only used on first startup if no ADMIN exists)
INITIAL_ADMIN_NAME=Platform Administrator
INITIAL_ADMIN_EMAIL=admin@subscriptiq.com
INITIAL_ADMIN_PASSWORD=AdminPassword@123

# Mail Configuration (Optional in development)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@subscriptiq.com

# Recurring Billing Scheduler Configuration
BILLING_SCHEDULER_ENABLED=true
BILLING_SCHEDULER_CRON=0 0 1 * * *
INVOICE_DUE_DAYS=7
